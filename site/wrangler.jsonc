{
  // Static site for getbema.dev, served by Cloudflare Workers static assets.
  // Deploy: cd site && npx wrangler deploy
  "name": "getbema",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": ".",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "getbema.dev", "custom_domain": true },
    { "pattern": "www.getbema.dev", "custom_domain": true }
  ]
}
